<%- include('partials/header') %>

  <div class="jumbotron text-center">
    <div class="container">
      <i class="fas fa-key fa-6x"></i>
      <% if (secret) { %>
       <h1 class="display-3">This is your secret!</h1>
        <p class="secret-text">
          <%= secret %>
        </p>
        <hr>
      <% } else { %>
        <h1 class="display-3">You have no secrets yet!</h1>
        <p class="secret-text">
          You can submit a secret by clicking the button below.
        </p>
        <hr>
      <% } %>

      <a class="btn btn-light btn-lg" href="/logout" role="button">Log Out</a>
      <a class="btn btn-dark btn-lg" href="/submit" role="button">Submit a Secret</a>
    </div>
  </div>

  <%- include('partials/footer') %>